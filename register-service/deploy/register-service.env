# register-service environment (installed to /etc/register-service/env)
REGSVC_DATA_DIR=/var/lib/register-service
REGSVC_SECRET_FILE=/etc/register-service/secret
REGSVC_LDAP_HOST=aletheia-core.pizzly-halfmoon.ts.net
REGSVC_LDAP_CA=/etc/register-service/ldap-ca.crt
REGSVC_RP_ID=register.phext.io
REGSVC_ORIGIN=https://register.phext.io
REGSVC_NUMBERS_FILE=/sites/web/register.phext.io/register-numbers.json
REGSVC_PORT=8791
# REGSVC_DRAIN_TOKEN is generated by install-on-box.sh (appended once)
# and authorizes read-only drains of the two queue logs by Emise's
# ticks. It is not a login credential and grants no writes.
